[app]

# اسم برنامه (همونطور که روی گوشی می‌بینید)
title = تبدیل مارک‌داون به پی‌دی‌اف

# اسم داخلی (فقط حروف کوچک، عدد و زیرخط)
package.name = mypdfapp

# دامنه (برعکس نوشته میشه)
package.domain = org.example

# کتابخانه‌های مورد نیاز (خیلی مهم!)
requirements = python3,kivy,markdown,weasyprint

# نسخه‌ی اندروید
android.api = 31
android.minapi = 21

# مجوزهای لازم
android.permissions = INTERNET, WRITE_EXTERNAL_STORAGE, READ_EXTERNAL_STORAGE

# بقیه تنظیمات پیش‌فرض (نیازی به تغییر نداره)
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
orientation = portrait
osx.python_version = 3
osx.kivy_version = 2.1.0
fullscreen = 0
